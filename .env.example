SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ADMIN_EMAIL=

# Optional temporary per-instance aggregate API/limiter counts in Vercel logs.
# No Redis writes. Disable after the observation period.
REQUEST_METRICS_ENABLED=false

# Public APK-only GitHub repository. Do not use the private source repository.
GITHUB_RELEASE_REPOSITORY=betdjvgu-dev/principessa-lock-releases
# Fine-grained token scoped only to the release repository with Contents: Read and write.
GITHUB_RELEASE_TOKEN=
